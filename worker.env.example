# Settings for a machine that runs the worker (npm run worker). Save as ~/.mibot/worker.env.
# The app shows the first two when you add the machine under Settings > Machines.
HUB_URL=https://hub.example.ts.net      # where this machine reaches the hub
WORKER_TOKEN=                           # shown once in the app

# HERMES_BIN=hermes                     # the hermes CLI on this machine
# HERMES_HOME_PRIMARY=~/.hermes         # this machine's own Hermes home; agents started here inherit its model settings and keys
# WORKER_DIR=~/.mibot/worker            # where the agents' homes are kept
# WORKER_PORT_BASE=8750                 # first local port for the agents' API servers

# WORKER_SLOTS=1                        # jobs run at once
# WORKER_MIN_FREE_MB=0                  # take no new job while less memory than this is available (0 = do not check)
# WORKER_MAX_AGENTS_MB=0                # take no new job while the agents started here use more than this together
# WORKER_QUIET_HOURS=06:30-07:50        # take no new job between these local times
# WORKER_IDLE_STOP_MIN=15               # stop a Bot's agent after this many idle minutes (0 = leave it running)
