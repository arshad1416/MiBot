# Settings for a machine that runs the worker (npm run worker), kept in ~/.mibot/worker.env.
# The first two are written for you when you connect the machine with a code from the app
# (Settings > Machines > Add). The rest are yours to add. Keep comments on lines of their own.

# Where this machine reaches the hub.
HUB_URL=https://hub.example.ts.net
# This machine's own key.
WORKER_TOKEN=

# The hermes CLI on this machine.
# HERMES_BIN=hermes
# This machine's own Hermes home; agents started here inherit its model settings and keys.
# HERMES_HOME_PRIMARY=~/.hermes
# Where the agents' homes are kept.
# WORKER_DIR=~/.mibot/worker
# First local port for the agents' API servers.
# WORKER_PORT_BASE=8750
# Local port of the page that takes the code, while the machine is not connected yet.
# WORKER_PAIR_PORT=8765

# Jobs run at once.
# WORKER_SLOTS=1
# Take no new job while less memory than this is available (0 = do not check).
# WORKER_MIN_FREE_MB=0
# Take no new job while the agents started here use more than this together.
# WORKER_MAX_AGENTS_MB=0
# Take no new job between these local times.
# WORKER_QUIET_HOURS=06:30-07:50
# Stop a Bot's agent after this many idle minutes (0 = leave it running).
# WORKER_IDLE_STOP_MIN=15
